# ── Jev (TypeSafe System One) ────────────────────────────────────────────────
# Recommended: server-side key. Read by the /api/jev proxy (Vercel function in
# prod, Vite middleware in `npm run dev`). Never reaches the browser bundle.
TYPESAFE_API_KEY=

# Optional overrides for the proxy.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest

# Local-only escape hatch: call TypeSafe straight from the browser, no proxy.
# VITE_* vars are inlined into the public JS bundle — do NOT set this on a
# deployed build.
# VITE_JEV_API_KEY=
# VITE_JEV_BASE_URL=https://api.typesafe.ai
# VITE_JEV_MODEL=jev-latest
